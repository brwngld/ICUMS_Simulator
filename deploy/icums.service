[Unit]
Description=ICUMS Simulator (Waitress)
After=network.target

[Service]
User=bernard
Group=bernard
WorkingDirectory=/home/bernard/ICUMS_Simulator
EnvironmentFile=/home/bernard/ICUMS_Simulator/.env
ExecStart=/home/bernard/ICUMS_Simulator/.venv/bin/waitress-serve --listen=127.0.0.1:8000 config.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
